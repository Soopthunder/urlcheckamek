# Producción (Vercel): agregá una integración "Redis" (Upstash) desde el Marketplace
# de Vercel y estas dos quedan seteadas solas. Si usás Upstash directo, poné:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protege /api/check para que solo tu cron externo lo pueda disparar
CRON_SECRET=cambia-esto-por-algo-random

# Opcional: sin key, PageSpeed Insights igual funciona pero con cuota más baja.
# Conseguila gratis en https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=
